# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev defaults. These match docker-compose.yml and the committed
# docker/postgres/init/00-roles.sql.
#
# SECURITY: the committed values are dev-only conveniences. Before this runs
# anywhere network-reachable -- including a demo VM -- rotate them and source
# them from a secret manager instead.
#
# The API connects as aea_app, which has neither BYPASSRLS nor table
# ownership. Connecting as aea_owner would silently disable tenant isolation
# across the whole platform.
DB_URL=jdbc:postgresql://localhost:5432/aea
DB_USER=aea_app
DB_PASSWORD=aea_app_dev_only

DB_MIGRATION_URL=jdbc:postgresql://localhost:5432/aea
DB_MIGRATION_USER=aea_owner
DB_MIGRATION_PASSWORD=aea_owner_dev_only

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
API_PORT=8080
WEB_PORT=5173

# ---------------------------------------------------------------------------
# Auth (M1.2)
# ---------------------------------------------------------------------------
# Generate a fresh one: openssl rand -base64 48
# Must be at least 32 bytes for HS256. Never reuse across environments.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# ---------------------------------------------------------------------------
# Model providers (M2 onward -- NOT needed for Milestone 1)
# ---------------------------------------------------------------------------
# Leave blank until M2. The application starts without them and uses a stub
# provider, which is also what CI uses: live model calls in CI would cost
# money on every push and make the test suite nondeterministic.
LLM_PROVIDER=stub
LLM_API_KEY=
# Tiers the router selects between. Cost per 1M tokens (input/output):
#   haiku-4-5  $1 / $5    sonnet-5  $2 / $10    opus-5  $5 / $25
LLM_MODEL_CHEAP=claude-haiku-4-5
LLM_MODEL_STANDARD=claude-sonnet-5
LLM_MODEL_REASONING=claude-opus-5

EMBEDDING_PROVIDER=stub
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Hard ceiling per query. The router's budget cannot exceed this.
MAX_COST_MICROS_PER_QUERY=100000
